@media all { @layer  { @font-face { font-family: A; src: url(a.woff2) format(woff2) tech(variations), local("A b"); font-weight: 400 700; unicode-range: U+25-FF, U+4??; font-display: swap } @keyframes t { entry 10% { color: red } calc(10%) { color: blue } exit calc(60%) { width: 1px } 50% { color: green } } @counter-style z { system: extends x; suffix: ")" } @layer a.b { @counter-style n { system: cyclic; symbols: x } } @layer a { @counter-style n { system: cyclic; symbols: y } } } }
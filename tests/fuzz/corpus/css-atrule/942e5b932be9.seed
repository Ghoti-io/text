:Ã@layer  { @property --a, --b { } @property --c { syntax: "<nosuch>"; inherits: maybe; initial-value: 1 } @property --d { syntax: "<length>"; initial-value: red } @counter-style f1 { system: cyclic; symbols: a; fallback: f2 } @counter-style f2 { system: cyclic; symbols: a; fallback: f1 } @font-face { font-family: A; src: url(a.woff2) format(woff2) tech(variations), local("A b"); font-weight: 400 700; unicode-range: U+25-FF, U+4??; font-display: swap } @color-profile device-cmyk { src: url(b.icc) } }
ua@media all { @layer a.b { @counter-style n { system: cyclic; symbols: x } } @layer a { @counter-style n { system: cyclic; symbols: y } } @keyframes k { from { color: red } 50%, 60% { color: blue; animation-name: x } to { color: green !important } } @counter-style p { system: extends q } @counter-style q { system: extends p } }
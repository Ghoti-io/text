(5@media all { @layer a { @font-feature-values A, "B c" { font-display: swap; @styleset { nice: 12 3 } @swash { s: 1 } @styleset { nice: 9 } } @font-face { src: url(x) } @font-palette-values --x { font-family: Bixa, "Foo Bar"; base-palette: 1; override-colors: 0 red, 3 #00f } a { color: red; @font-face { font-family: N; src: url(n) } } } }
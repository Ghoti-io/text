å\@font-palette-values --x { font-family: Bixa, "Foo Bar"; base-palette: 1; override-colors: 0 red, 3 #00f } @layer a, b; @layer b { @keyframes k { from { color: red } } } @layer a { @keyframes k { from { color: blue } } } @top-left { content: "x" } @color-profile --p { src: url(a.icc); rendering-intent: perceptual; components: a, b }
b@media all { @counter-style f1 { system: cyclic; symbols: a; fallback: f2 } @counter-style f2 { system: cyclic; symbols: a; fallback: f1 } @property --a <length>: 5px; @property --b type(<length> | auto): auto; @property --c; @property --d: ; @property --e <foo>; @property --f, --g <length>; @counter-style z { system: extends x; suffix: ")" } @layer a.b { @counter-style n { system: cyclic; symbols: x } } @layer a { @counter-style n { system: cyclic; symbols: y } } }
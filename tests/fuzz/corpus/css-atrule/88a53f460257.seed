b@media all { @counter-style f1 { system: cyclic; symbols: a; fallback: f2 } @counter-style f2 { system: cyclic; symbols: a; fallback: f1 } @layer { @font-face { font-family: L; src: url(l) } } @counter-style z { system: extends x; suffix: ")" } @supports (display: grid) { @font-face { font-family: S; src: url(s) } } }
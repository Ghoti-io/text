3û@media all { @font-face { src: local(inherit), url(foo.ttf), junk, local("x") format(bad) } @media (min-width: 100px) { @keyframes m { from { color: red } } } @counter-style bad { system: alphabetic; symbols: a } @layer a, b; @layer b { @keyframes k { from { color: red } } } @layer a { @keyframes k { from { color: blue } } } }
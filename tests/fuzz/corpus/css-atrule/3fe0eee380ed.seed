>Ò@layer b { @counter-style bad { system: alphabetic; symbols: a } @counter-style x { system: fixed 5; symbols: a b; range: 1 3, infinite 0; pad: 3 "0"; negative: "-" "!" } @layer a, b; @layer b { @keyframes k { from { color: red } } } @layer a { @keyframes k { from { color: blue } } } @counter-style y { system: additive; additive-symbols: 3 c, 2 b, 1 a } }
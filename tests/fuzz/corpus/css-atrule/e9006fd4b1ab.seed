8V@font-face { font-family: "B c"; src: local(B); font-style: oblique 10deg 20deg; font-feature-settings: "liga" 1, "kern"; font-variation-settings: "wght" 300 } @counter-style f1 { system: cyclic; symbols: a; fallback: f2 } @counter-style f2 { system: cyclic; symbols: a; fallback: f1 } @namespace svg url(http://www.w3.org/2000/svg); @charset "utf-8"; @import url(a.css) layer(x);
+@color-profile device-cmyk { src: url(b.icc) } @keyframes t { entry 10% { color: red } calc(10%) { color: blue } exit calc(60%) { width: 1px } 50% { color: green } } a { color: red; @font-face { font-family: N; src: url(n) } } @color-profile --p { src: url(a.icc); rendering-intent: perceptual; components: a, b }
¬Z@counter-style x { system: fixed 5; symbols: a b; range: 1 3, infinite 0; pad: 3 "0"; negative: "-" "!" } @counter-style z { system: extends x; suffix: ")" } a { color: red; @font-face { font-family: N; src: url(n) } } @namespace svg url(http://www.w3.org/2000/svg); @charset "utf-8"; @import url(a.css) layer(x);
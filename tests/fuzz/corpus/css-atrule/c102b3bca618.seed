Mo@media all { @counter-style f1 { system: cyclic; symbols: a; fallback: f2 } @counter-style f2 { system: cyclic; symbols: a; fallback: f1 } @counter-style y { system: additive; additive-symbols: 3 c, 2 b, 1 a } @font-feature-values X { @bogus { a: 1 } @ornaments { o: 1 2 } } @font-face { font-family: "B c"; src: local(B); font-style: oblique 10deg 20deg; font-feature-settings: "liga" 1, "kern"; font-variation-settings: "wght" 300 } }
(í@counter-style y { system: additive; additive-symbols: 3 c, 2 b, 1 a } @font-face { font-family: C; ascent-override: 90% 80%; size-adjust: 110%; font-width: 75% 100%; font-size: 10 20; src: url(c) } @font-face { src: local(inherit), url(foo.ttf), junk, local("x") format(bad) } @layer a.b { @counter-style n { system: cyclic; symbols: x } } @layer a { @counter-style n { system: cyclic; symbols: y } }
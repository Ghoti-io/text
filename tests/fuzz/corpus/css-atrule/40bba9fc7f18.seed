ð	@media all { @counter-style x { system: fixed 5; symbols: a b; range: 1 3, infinite 0; pad: 3 "0"; negative: "-" "!" } @counter-style z { system: extends x; suffix: ")" } @counter-style bad { system: alphabetic; symbols: a } @counter-style x { system: fixed 5; symbols: a b; range: 1 3, infinite 0; pad: 3 "0"; negative: "-" "!" } }
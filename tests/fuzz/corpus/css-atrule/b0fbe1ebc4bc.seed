L£@layer a.b { @counter-style n { system: cyclic; symbols: x } } @layer a { @counter-style n { system: cyclic; symbols: y } } @counter-style f1 { system: cyclic; symbols: a; fallback: f2 } @counter-style f2 { system: cyclic; symbols: a; fallback: f1 } @font-face { font-family: A; src: url(a.woff2) format(woff2) tech(variations), local("A b"); font-weight: 400 700; unicode-range: U+25-FF, U+4??; font-display: swap } @font-face { font-family: "B c"; src: local(B); font-style: oblique 10deg 20deg; font-feature-settings: "liga" 1, "kern"; font-variation-settings: "wght" 300 }
# Build output
build

# Documentation generated by Doxygen
docs

# Example output files
example.output.*

# Task documents
tasks

# tools/ is NOT ignored. It was, with no comment saying why, and the effect was
# that tools/coverage.sh and tools/valgrind.supp were never committed - so
# `make coverage` did not exist for anyone who cloned this repository, and
# `make test-valgrind` died on a missing suppressions file before running a
# single test. Build products belong in build/; scripts the Makefile invokes
# belong in the repository.

# Fuzzer crash/leak artifacts (reproducers are promoted to tests instead)
crash-*
# libFuzzer's -minimize_crash=1 writes these beside crash-*, and only the
# latter was ignored - so a minimisation left a dozen untracked files that look
# like fixtures and are not.
minimized-from-*
# libFuzzer also writes one of these for an input that is merely very slow -
# a finding to act on, not a file to keep.
slow-unit-*
leak-*
timeout-*
oom-*

# Third-party data the generators read; the generated tables are committed,
# the data they came from is not (tools/idna/fetch.sh).
third_party

# Python bytecode from the generators; tools/oracle/idna_diff.py imports them,
# and importing is what writes these.
__pycache__

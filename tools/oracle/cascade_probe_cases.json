[
 {
  "name": "A1 important revert-layer in a; important b; unlayered normal 3px (literal reading: 0px)",
  "html": "<style>@layer a, b; @layer b { div { margin-left: 2px !important } } @layer a { div { margin-left: 1px !important; margin-left: revert-layer !important } } div { margin-left: 3px }</style><div id=t></div>",
  "expr": "getComputedStyle(document.getElementById('t')).marginLeft"
 },
 {
  "name": "A2 important revert-layer in a; important b only (0px if the normal level is the floor, 2px if importance is kept)",
  "html": "<style>@layer a, b; @layer b { div { margin-left: 2px !important } } @layer a { div { margin-left: revert-layer !important } }</style><div id=t></div>",
  "expr": "getComputedStyle(document.getElementById('t')).marginLeft"
 },
 {
  "name": "A3 important revert-layer in a with a normal in a and an unlayered normal 3px (0px literal, 3px if the unlayered is not between)",
  "html": "<style>@layer a { div { margin-left: 1px } div { margin-left: revert-layer !important } } div { margin-left: 3px }</style><div id=t></div>",
  "expr": "getComputedStyle(document.getElementById('t')).marginLeft"
 },
 {
  "name": "B1 inner important revert-layer in :host, outer normal 1px (0px literal, 1px if the outer normal is not between)",
  "html": "<style>#t { margin-left: 1px }</style><div id=t><template shadowrootmode=open><style>@layer a { :host { margin-left: revert-layer !important } }</style></template></div>",
  "expr": "getComputedStyle(document.getElementById('t')).marginLeft"
 },
 {
  "name": "B2 inner normal revert-layer in :host, outer normal 1px (1px: the outer wins)",
  "html": "<style>#t { margin-left: 1px }</style><div id=t><template shadowrootmode=open><style>@layer a { :host { margin-left: revert-layer } }</style></template></div>",
  "expr": "getComputedStyle(document.getElementById('t')).marginLeft"
 },
 {
  "name": "D1 img width=200 (hint), ::slotted(img) {width: 100px} from the shadow tree (100px if the hint is an origin of its own)",
  "html": "<div id=h><template shadowrootmode=open><style>::slotted(img) { width: 100px }</style><slot></slot></template><img id=t width=200 height=10></div>",
  "expr": "getComputedStyle(document.getElementById('t')).width"
 },
 {
  "name": "D2 img width=200 (hint), light-tree rule img {width: 100px} (100px)",
  "html": "<style>img { width: 100px }</style><img id=t width=200 height=10>",
  "expr": "getComputedStyle(document.getElementById('t')).width"
 },
 {
  "name": "E1 img width=200 (hint), style=width:revert-layer (200px: revert-layer rolls back to the hint)",
  "html": "<img id=t width=200 height=10 style='width: revert-layer'>",
  "expr": "getComputedStyle(document.getElementById('t')).width"
 },
 {
  "name": "G1 revert-rule !important with a normal declaration in the same rule, an earlier rule 1px (1px)",
  "html": "<style>div { margin-left: 1px } .x { margin-left: 5px; margin-left: revert-rule !important }</style><div id=t class=x></div>",
  "expr": "getComputedStyle(document.getElementById('t')).marginLeft"
 },
 {
  "name": "G2 normal revert-rule, the same rule's important 5px (5px)",
  "html": "<style>div { margin-left: 1px } .x { margin-left: 5px !important; margin-left: revert-rule }</style><div id=t class=x></div>",
  "expr": "getComputedStyle(document.getElementById('t')).marginLeft"
 },
 {
  "name": "G3 supports(revert-rule) as a witness that the keyword is parsed",
  "html": "<div id=t></div>",
  "expr": "CSS.supports('margin-left', 'revert-rule')"
 }
]